# AURA settings - copy this file to ".env" (same folder) and fill in your own values.
# .env is ignored by Git, so your keys never get uploaded. Leave a value empty to use the default.
# Never commit your real .env file.

# ---------------------------------------------------------------- REQUIRED
# The AI brain and speech recognition. Free key: https://console.groq.com/keys
LLM_API_KEY=

# ---------------------------------------------------------------- About you
USER_NAME=
# One line about you, so answers fit you (e.g. "a computer science student who plays football")
USER_ABOUT=
# Names/terms you say often, to help speech recognition (comma-separated)
VOCAB_WORDS=
# IANA timezone, e.g. Europe/London, America/New_York, Asia/Tokyo
LOCAL_TIMEZONE=UTC
# Fallback city if automatic location fails, e.g. London, UK
LOCATION=

# ---------------------------------------------------------------- Optional services
# Smarter answers (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Live web search (free tier): https://tavily.com
TAVILY_API_KEY=
# Spotify playback: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional sign-in screen (Firebase web API key). Empty = single-user mode with no sign-in.
FIREBASE_API_KEY=
# Hugging Face token for AURA Studio image editing / video: https://huggingface.co/settings/tokens
HF_TOKEN=
# More models in AURA Spatial: https://sketchfab.com/settings/password
SKETCHFAB_TOKEN=
# Android control over USB debugging (path to adb.exe if it isn't on your PATH)
ADB_PATH=adb

# ---------------------------------------------------------------- Voice
# Microphone index (empty = system default). Run: python list_mic.py
MIC_DEVICE_INDEX=
# edge | orpheus | auto
VOICE_ENGINE=edge
VOICE_NAME=en-US-EmmaMultilingualNeural
# Language code, or "auto" to detect it
VOICE_LANGUAGE=en
PUSH_TO_TALK_HOTKEY=ctrl+alt+a
# Always-on wake word ("AURA, ..."). When true, everything the mic hears is sent to the
# speech-to-text service to check for the wake word. Off by default.
WAKE_WORD_ENABLED=false

# ---------------------------------------------------------------- Files
# Semicolon-separated folders
EXTRA_SEARCH_FOLDERS=
KNOWLEDGE_FOLDERS=

# ---------------------------------------------------------------- Phone app
PHONE_BRIDGE_PORT=8740
# Let a paired phone view and control this PC's screen (LINK). Off by default.
PHONE_REMOTE_CONTROL=false

# ---------------------------------------------------------------- Safety
# Ask before running AI-written code / force-closing apps, and block PC control from the
# public internet (Apple Watch via Tailscale Funnel). See SECURITY.md before changing.
SAFE_MODE=true
